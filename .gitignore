.DS_Store
__pycache__/
*.pyc
.venv/
target/
.snfoundry_cache/
results/workspaces/
.env
vendor/
results/shots/

# Run data: only the analysis-ready main.jsonl is published. Everything else in
# results/runs/ is a per-stream input to a merge that already happened, or
# main.full.jsonl, which keeps the transcripts and submitted code locally (640 MB
# of the 655, and nothing in bench/ reads either field).
#
# Allowlist, not a prefix list: the old enumeration (gap-*, ladder-*, topup*,
# refill-*, probe-*) let every new naming convention escape. qwen38-* was five
# files away from being committed before a pre-commit check caught it.
results/runs/*.jsonl
!results/runs/main.jsonl
results/runs/*.bak
results/runs/*.bak2

# Session tooling. The directory stays out, but settings.json is tracked: it holds
# the visual-QA hooks (a reminder on html_report.py edits, and a PreToolUse gate that
# blocks a commit while the screenshots are older than the UI files). Those are part of
# how this repo is worked on, and leaving them untracked meant a fresh clone got
# bench/screenshot.py without the enforcement that makes anyone run it.
.claude/*
!.claude/settings.json
